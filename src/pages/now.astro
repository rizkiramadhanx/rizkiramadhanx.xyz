---
import ShellLayout from '../layouts/ShellLayout.astro';
import Section from '../components/Section.astro';

const experiences = [
  {
    role: 'Front-End Developer',
    company: 'Mutiara Cahaya Slawi',
    period: 'October 2024 - Now',
    points: [
      'Contributed to revamping the internal HRIS application to improve user experience and system functionality.',
      'Developed and maintained ERP modules to support core business operations.',
      'Integrated backend data using API technologies and ensured feature stability and proper functionality.',
      "Assisted in migrating applications to containerized deployment (e.g. Jenkins) for streamlined development and deployment workflows.",
      'Improved and initiated the company\'s SDLC processes to enhance overall development efficiency and product quality.',
    ],
    stack: 'NextJS, ReactJS, Chakra UI, React Native (Android), CI/CD (Jenkins, GitHub Actions)',
  },
  {
    role: 'Front-End Developer',
    company: 'Komerce',
    period: 'August 2023 - October 2024',
    points: [
      'Created responsive web by slicing designs into code, ensuring easy-to-maintain codebase.',
      'Integrated backend data using API technology, ensuring all features work properly.',
      'Collaborated with the team using Git and GitLab.',
      'Contributed to a project with more than 26,000 users (komship.id and komcards.id).',
      'Contributed to internal admin project to monitor internal business.',
    ],
    stack: 'VueJS, NuxtJS, Bootstrap, ReactJS, Ant-Design, Tailwind CSS',
  },
  {
    role: 'Front-End Developer (Internship)',
    company: 'DOT Indonesia',
    period: 'August 2022 - December 2022',
    points: [
      'Collaborated with a cross-functional team to deliver a complex mailing web application on time.',
      'Built responsive web by breaking down designs into maintainable code.',
      'Integrated backend data using API technology.',
      'Built reusable components and optimized frontend performance for scalability and smooth UX.',
    ],
    stack: 'NextJS, React, Ant-Design, Tailwind CSS, react-hook-form, react-query',
  },
  {
    role: 'Front-End Web and Back-End Developer (Bootcamp)',
    company: 'Dicoding x Kampus Merdeka',
    period: 'August 2021 - January 2022',
    points: [
      'Developed responsive and user-friendly websites using HTML, CSS, and JavaScript.',
      'Collaborated with a team of 3 using Git and GitHub for version control and code reviews.',
      'Integrated and processed backend data from REST APIs.',
      'Delivered capstone project on time, meeting all functional and UI/UX standards.',
    ],
    stack: 'HTML, CSS, Javascript, Git',
  },
];

const hardSkills = [
  { group: 'Languages', items: ['TypeScript', 'JavaScript'] },
  { group: 'Frontend', items: ['React', 'Next.js', 'Vue', 'Nuxt'] },
  { group: 'Mobile', items: ['React Native', 'Flutter'] },
  { group: 'Styling', items: ['Tailwind CSS', 'Chakra UI', 'Ant Design', 'Bootstrap'] },
  { group: 'Backend', items: ['NestJS', 'Express', 'REST API'] },
  { group: 'Tools & Ops', items: ['Git', 'Jenkins', 'GitHub Actions', 'CI/CD'] },
];

const relatedProjects = [
  'Komcards (Payment Card)',
  'Infralib - PT Sarana Multi Infrastruktur (CMS)',
  'HRIS Mutiara Cahaya (Internal)',
  'SPARK PDT Mobile',
  'ERP Mutiara Cahaya (Retail ERP)',
  'SPARK HRIS',
  'Kubik Billing (Side project - profitable)',
  'Stocksense - Financial Tools (Ongoing)',
  'Kasir Agen (Bookkeeping for Mini ATM Agents)',
];

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'About & Experience – Rizki Ramadhan',
  url: 'https://rizkiramadhanx.xyz/now',
  mainEntity: {
    '@type': 'Person',
    name: 'Rizki Ramadhan',
    jobTitle: 'Software Engineer',
    knowsAbout: hardSkills.flatMap((row) => row.items),
    hasOccupation: experiences.map((exp) => ({
      '@type': 'Occupation',
      name: exp.role,
      occupationLocation: { '@type': 'Organization', name: exp.company },
      skills: exp.stack,
    })),
  },
};
---

<ShellLayout title="About & Experience – Rizki Ramadhan | Software Engineer" description="Rizki Ramadhan's experience, skills, and education. Software Engineer at Mutiara Cahaya Slawi, previously at Komerce and DOT Indonesia." schema={profileSchema}>
  <div>
    <section class="border-b rule px-4 sm:px-10 py-4 sm:py-4">
      <h1 class="display-xl max-w-[16ch] mb-6 enter enter-1">About</h1>
      <p class="max-w-[62ch] text-[0.9375rem] leading-[1.75] text-[#a8adb3]">
        Software Engineer with 3 years of experience building web and mobile apps.
        I work mainly with React, Next.js, Vue, React Native and Flutter, and I handle
        backend with NestJS or Express when a project needs it. I have shipped
        features for products with 26,000+ users and cut load times by up to 20%.
        Currently at Mutiara Cahaya Slawi, based in Tegal, Indonesia.
      </p>
    </section>

    <section class="border-b rule px-4 sm:px-10 py-4 sm:py-4 reveal">
      <h2 class="display-md mb-8">Experience</h2>
      <div class="flex flex-col gap-y-9 reveal-group">
        {experiences.map((exp) => (
          <div class="relative pb-2">
            <h3 class="font-display text-[0.9375rem] leading-snug">{exp.role}</h3>
            <p class="mono-sm text-[#a8adb3] mt-1.5">{exp.company} · {exp.period}</p>
            <ul class="mt-3 flex flex-col gap-y-1.5">
              {exp.points.map((point) => (
                <li class="flex gap-x-2.5 text-[0.8125rem] leading-[1.7] text-[#a8adb3] max-w-[64ch]">
                  <span class="text-[#e8eaed] shrink-0">—</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <p class="mono-sm text-[#a8adb3] mt-3.5 opacity-80">{exp.stack}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-b rule px-4 sm:px-10 py-4 sm:py-4 reveal">
      <h2 class="display-md mb-8">Hard Skills</h2>
      <div class="flex flex-col gap-y-5">
        {hardSkills.map((row) => (
          <div class="sm:flex sm:items-baseline sm:gap-x-8">
            <div class="sm:w-36 shrink-0 mb-2 sm:mb-0 text-[0.9375rem] font-medium text-[#e8eaed]">
              {row.group}
            </div>
            <div class="flex flex-wrap gap-2">
              {row.items.map((item) => (
                <span class="chip px-3 py-1 rounded-full text-[0.8125rem]">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="border-b rule px-4 sm:px-10 py-4 sm:py-4 reveal">
      <h2 class="display-md mb-8">Related Projects</h2>
      <ul class="flex flex-col gap-y-1.5 max-w-[60ch]">
        {relatedProjects.map((project) => (
          <li class="flex gap-x-2.5 text-[0.8125rem] leading-[1.7] text-[#a8adb3]">
            <span class="text-[#e8eaed] shrink-0">—</span>
            <span>{project}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="px-4 sm:px-10 py-4 sm:py-4 reveal">
      <h2 class="display-md mb-8">Education</h2>
      <div class="flex flex-col gap-y-5">
        <div>
          <p class="font-display text-[0.9375rem]">Universitas Muhammadiyah Purwokerto</p>
          <p class="mono-sm text-[#a8adb3] mt-1">Informatics Engineering · 2019 – 2023</p>
        </div>
        <div>
          <p class="font-display text-[0.9375rem]">SMA Negeri 4 Kota Tegal</p>
          <p class="mono-sm text-[#a8adb3] mt-1">Mathematics and Science · 2016 – 2019</p>
        </div>
      </div>
    </section>
  </div>
</ShellLayout>
