---
import ShellLayout from '../layouts/ShellLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects – Rizki Ramadhan',
  url: 'https://rizkiramadhanx.xyz/project',
  hasPart: projects.map((project) => ({
    '@type': 'CreativeWork',
    name: project.title,
    abstract: project.description,
    keywords: project.technology.join(', '),
    ...(project.url.deploy ? { url: project.url.deploy } : {}),
  })),
};
---

<ShellLayout title="Projects – Rizki Ramadhan | Software Engineer Portfolio" description="A collection of web projects by Rizki Ramadhan — including Komcards, Infralib, Komship, The Quran App, and more." schema={collectionSchema}>
  <div class="px-4 sm:px-10 py-4 sm:py-4">
    <h1 class="display-xl max-w-[13ch] enter enter-1">Projects</h1>
    <p class="mt-6 max-w-[54ch] enter enter-2 text-[0.9375rem] leading-[1.7] text-[#a8adb3]">
      Client work and my own products. ERP, HRIS, payment cards, and bookkeeping
      tools for Mini ATM agents.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-12 reveal reveal-group">
      {projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          image={project.image}
          technology={project.technology}
          url={project.url}
        />
      ))}
    </div>
  </div>
</ShellLayout>
