---
import { Icon } from 'astro-icon/components';

interface Props {
  slug: string;
  title: string;
  description: string;
  technology: string[];
  image: string;
  url: {
    source?: string;
    deploy?: string;
  };
}

const { slug, title, description, technology, image, url } = Astro.props;
---

<article class="card rounded-2xl overflow-hidden flex flex-col group">
  <div class="relative overflow-hidden bg-white/5">
    <a href={`/project/${slug}`} aria-label={`${title} details`}>
    <img
      src={image}
      class="w-full h-[172px] object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
      alt={`Screenshot of the ${title} project`}
      loading="lazy"
      decoding="async"
      width="400"
      height="172"
    />
    </a>
  </div>

  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-start justify-between gap-x-3">
      <h2 class="font-display text-[0.9375rem] leading-snug capitalize text-[#e8eaed]">
        <a href={`/project/${slug}`} class="hover:text-white transition-colors duration-200">
          {title}
        </a>
      </h2>
      <div class="flex gap-x-1.5 shrink-0 pt-1">
        {url.source && (
          <a
            href={url.source}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#a8adb3] hover:text-white transition-colors duration-200"
            aria-label={`${title} source code`}
          >
            <Icon name="ri:github-fill" size={17} />
          </a>
        )}
        {url.deploy && (
          <a
            href={url.deploy}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#a8adb3] hover:text-white transition-colors duration-200"
            aria-label={`${title} live site`}
          >
            <Icon name="ri:global-line" size={17} />
          </a>
        )}
      </div>
    </div>

    <p class="text-[0.8125rem] leading-[1.5] text-[#a8adb3] mt-3 text-ellipsis-3">
      {description}
    </p>

    <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-5 pt-4 border-t rule">
      {technology.map((tech) => (
        <span class="mono-sm">{tech}</span>
      ))}
    </div>
  </div>
</article>
